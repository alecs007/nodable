// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`exportSession > latex > writes a forest environment 1`] = `
"\\begin{forest}
for tree={draw, rounded corners, s sep=6mm, l sep=8mm, align=center}
[{$\\lor$}
  [{$\\lnot$}
    [{$p$}]
  ]
  [{$q$}]
]
\\end{forest}"
`;

exports[`exportSession > plain text > writes an indented tree 1`] = `
"∨
├── ¬
│   └── p
└── q"
`;

exports[`exportSession > svg > writes a standalone document 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" width="252" height="324" viewBox="0 0 252 324">
<style>.nodable-surface { fill: #ffffff }
  .nodable-edge { stroke: #5b6b7c; stroke-width: 1.5; fill: none }
  .nodable-box { fill: #ffffff; stroke: #1f2933; stroke-width: 1.5; rx: 8 }
  .nodable-box-slot { fill: none; stroke-dasharray: 4 4; stroke: #8595a6 }
  .nodable-box-leaf { fill: #eef4fb }
  .nodable-label { font: 500 18px system-ui, sans-serif; fill: #1f2933; text-anchor: middle }
  .nodable-divider { stroke: #8595a6; stroke-width: 1; stroke-dasharray: 4 4 }
  .nodable-choice { font: 500 11px system-ui, sans-serif; fill: #5b6b7c; text-anchor: middle }
  .nodable-cursor { fill: #c1452b }</style>
<rect class="nodable-surface" width="100%" height="100%" />
<line class="nodable-edge" x1="115" y1="84" x2="87" y2="140" />
<line class="nodable-edge" x1="76" y1="184" x2="76" y2="240" />
<line class="nodable-edge" x1="137" y1="84" x2="165" y2="140" />
<rect class="nodable-box" x="90" y="40" width="72" height="44" />
<text class="nodable-label" x="126" y="68">∨</text>
<rect class="nodable-box" x="40" y="140" width="72" height="44" />
<text class="nodable-label" x="76" y="168">¬</text>
<rect class="nodable-box nodable-box-leaf" x="40" y="240" width="72" height="44" />
<text class="nodable-label" x="76" y="268">p</text>
<rect class="nodable-box nodable-box-leaf" x="140" y="140" width="72" height="44" />
<text class="nodable-label" x="176" y="168">q</text>
<path class="nodable-cursor" d="M 126 4 l -7 11 h 4 v 13 h 6 v -13 h 4 z" />
</svg>"
`;
